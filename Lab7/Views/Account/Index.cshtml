@model List<NetCoreMVC_LAB05.Models.Account>

<h2>Danh sách tài khoản</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Thêm tài khoản
    </a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Số điện thoại</th>
            <th>Giới tính</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.Gender</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-warning">Sửa</a>

                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>