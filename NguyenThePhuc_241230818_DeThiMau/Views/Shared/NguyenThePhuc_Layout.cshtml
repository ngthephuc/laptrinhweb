
<!DOCTYPE html>
<html>
<head>
    <title>Free Home Shoppe Website Template</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="@Url.Content("~/Content/css/style.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/global.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/slider.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/easy-responsive-tabs.css")" rel="stylesheet" />
</head>

<body>
    <div class="wrap">
        @await Html.PartialAsync("_NguyenThePhuc_Header")

        @RenderBody()
    </div>

    @await Html.PartialAsync("_NguyenThePhuc_Footer")

    <script src="@Url.Content("~/Script/js/jquery-1.7.2.min.js")"></script>
    <script src="@Url.Content("~/Script/js/jquery.easing.js")"></script>
    <script src="@Url.Content("~/Script/js/easing.js")"></script>
    <script src="@Url.Content("~/Script/js/easyResponsiveTabs.js")"></script>
    <script src="@Url.Content("~/Script/js/jquery.accordion.js")"></script>
    <script src="@Url.Content("~/Script/js/move-top.js")"></script>
    <script src="@Url.Content("~/Script/js/script.js")"></script>
    <script src="@Url.Content("~/Script/js/slides.min.jquery.js")"></script>
    <script src="@Url.Content("~/Script/js/startstop-slider.js")"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
