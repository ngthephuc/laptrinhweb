
@using NguyenThePhuc_241230818_DeThiMau.Models

<!-- Begin Header -->
<div class="header">

    <div class="header_top">
        <div class="logo">
            <a href="/">
                <img src="@Url.Content("~/Content/images/logo.png")" alt="Logo" />
            </a>
        </div>

        <div class="cart">
            <span>Welcome to our Online Store!</span>
            <span>Cart:</span>

            <div id="dd" class="wrapper-dropdown-2">
                0 item(s) - $0.00
                <ul class="dropdown">
                    <li>You have no items in your Shopping cart</li>
                </ul>
            </div>
        </div>

        <div class="clear"></div>
    </div>

    <div class="header_bottom">

        <div class="menu">
            <ul>
                <li class="active">
                    <a href="/">Nguyễn Thế Phúc</a>
                </li>

                @if (ViewBag.LoaiHangs != null)
                {
                    foreach (LoaiHang loai in ViewBag.LoaiHangs)
                    {
                        <li>
                            <a href="#">@loai.TenLoai</a>
                        </li>
                    }
                }

                <div class="clear"></div>
            </ul>
        </div>

        <div class="search_box">
            <form action="#" method="get">
                <input type="text"
                       name="search"
                       value="Search"
                       onfocus="if(this.value == 'Search') this.value = '';"
                       onblur="if(this.value == '') this.value = 'Search';" />

                <input type="submit" value="" />
            </form>
        </div>

        <div class="clear"></div>

    </div>

</div>
<!-- End Header -->
