<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DEMO LAB</title>

    <link rel="stylesheet" href="~/css/site.css" />

</head>

<body>

    <!-- MENU -->
    <header class="header">

        <div class="logo">
            DEMO LAB
        </div>

        <nav>

            <a asp-controller="Home"
               asp-action="Index">
                Trang chủ
            </a>

            <a href="#">
                Giới thiệu
            </a>

            <a href="#">
                Liên hệ
            </a>

            <a href="#">
                Sản phẩm
            </a>

        </nav>

    </header>


    <!-- NỘI DUNG -->
    <main>

        @RenderBody()

    </main>


    <!-- FOOTER -->
    <footer>

        <div class="footer-column">

            <h2>GIỚI THIỆU</h2>

            <p>
                Lorem ipsum dolor sit amet consectetur adipisicing elit.
                Debitis ab suscipit deserunt quisquam impedit magni
                mollitia.
            </p>

        </div>


        <div class="footer-column">

            <h2>LIÊN HỆ</h2>

            <p>
                Lorem ipsum dolor sit amet consectetur adipisicing elit.
                Quisquam impedit magni mollitia.
            </p>

        </div>

    </footer>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>