@model List<_241230818_NTP.Models.Product>

<h2>Quản lý sản phẩm</h2>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Created At</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.ID</td>
                <td>@p.Name</td>
                <td>@p.Price.ToString("N0") đ</td>
                <td>@p.CreatedAt.ToString("dd-MM-yyyy")</td>
                <td>
                    <img src="@p.Image" width="80" />
                </td>
                <td>
                    <button class="btn btn-success">View</button>
                </td>
            </tr>
        }
    </tbody>
</table>